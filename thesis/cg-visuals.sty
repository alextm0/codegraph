% CodeGraph thesis: shared diagrams and code listing presentation
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cg-visuals}[2026/06/03 CodeGraph thesis visuals]

\RequirePackage{tcolorbox}
\RequirePackage{adjustbox}
\tcbuselibrary{listings,skins,breakable}

% ---------------------------------------------------------------------------
% Listing styles (require colors from main.tex)
% ---------------------------------------------------------------------------
\lstdefinestyle{cgbase}{
    basicstyle=\ttfamily\footnotesize,
    numbers=none,
    frame=none,
    backgroundcolor=\color{backcolour},
    xleftmargin=0pt,
    xrightmargin=0pt,
    aboveskip=3pt,
    belowskip=3pt,
    breaklines=true,
    breakatwhitespace=true,
    columns=fullflexible,
    keepspaces=false,
    showstringspaces=false,
    tabsize=2,
}

\lstdefinestyle{cgpython}{
    style=cgbase,
    commentstyle=\color{codegreen}\itshape,
    keywordstyle=\color{codeblue}\bfseries,
    stringstyle=\color{codepurple},
}

\lstdefinestyle{cgjson}{
    style=cgbase,
    language=json,
}

\lstdefinestyle{cgshell}{
    style=cgbase,
    keywordstyle=\color{latticeblue}\bfseries,
    commentstyle=\color{codegreen}\itshape,
}

\lstdefinestyle{cgcypher}{
    style=cgbase,
    commentstyle=\color{codegreen}\itshape,
    keywordstyle=\color{latticeblue}\bfseries,
}

% ---------------------------------------------------------------------------
% Framed listing environments
% ---------------------------------------------------------------------------
\tcbset{
    cgbox/.style={
        enhanced,
        arc=4pt,
        boxrule=0.55pt,
        colframe=latticegray!45,
        colback=backcolour,
        left=5pt,
        right=5pt,
        top=5pt,
        bottom=5pt,
        width=\linewidth,
        boxsep=0pt,
        fonttitle=\bfseries\small,
        coltitle=black!85,
        titlerule=0.35pt,
        colbacktitle=white,
        before skip=8pt plus 2pt minus 2pt,
        after skip=10pt plus 2pt minus 2pt,
        attach boxed title to top left={
            yshift=-2.5mm,
            xshift=3mm
        },
        boxed title style={
            arc=2pt,
            boxrule=0.35pt,
            colframe=latticegray!40,
        },
    },
    cglisting/.style={
        cgbox,
        listing only,
        breakable,
        listing options={
            breaklines=true,
            breakatwhitespace=true,
            columns=fullflexible,
            keepspaces=false,
        },
    },
}

\newtcblisting{cgpython}[2][]{
    cglisting,
    title={#2},
    listing options={style=cgpython},
    #1
}

\newtcblisting{cgjson}[2][]{
    cglisting,
    title={#2},
    listing options={style=cgjson,language=json},
    #1
}

\newtcblisting{cgshell}[2][]{
    cglisting,
    title={#2},
    listing options={style=cgshell},
    #1
}

\newtcblisting{cgcypher}[2][]{
    cglisting,
    title={#2},
    listing options={style=cgcypher},
    #1
}

% Side-by-side code panels (chapter 4)
\newenvironment{cgcodesplit}[1][Code extraction example]%
{%
    \begin{figure}[htbp]
    \centering
    \caption{#1}%
}{%
    \end{figure}%
}

\newcommand{\cgcodesplitpanel}[2]{%
    \begin{minipage}[t]{0.475\linewidth}%
    \begin{cgpython}[#1]{#2}%
}

\newcommand{\cgcodesplitpanelend}{%
    \end{cgpython}%
    \end{minipage}%
}

% ---------------------------------------------------------------------------
% TikZ diagram styles (call after \usepackage{tikz})
% ---------------------------------------------------------------------------
\newcommand{\cgfonttitle}{\fontsize{10}{12}\selectfont\bfseries}
\newcommand{\cgfontinner}{\fontsize{8}{10}\selectfont}
\newcommand{\cgfontcaption}{\fontsize{9}{11}\selectfont}

\newcommand{\cgdiagramsetup}{%
    \tikzset{
        % Core Node Style
        cgnode/.style={
            draw=cgslate,
            line width=0.8pt,
            rounded corners=2pt,
            fill=cgsoftgray,
            font=\cgfontinner,
            inner sep=0.25cm,
            align=center,
        },
        % Semantic variants
        cgseed/.style={cgnode, fill=cgorange},
        cgintermediate/.style={cgnode, fill=cgblue},
        cgtarget/.style={cgnode, fill=cggreen, double, double distance=1pt},
        % Pipeline stages
        cgstage/.style={
            cgnode,
            minimum width=2.6cm,
            minimum height=1.35cm,
            font=\cgfonttitle,
            text width=2.4cm,
        },
        cgstage/parse/.style={cgstage, fill=cgblue},
        cgstage/graph/.style={cgstage, fill=cggreen},
        cgstage/online/.style={cgstage, fill=cgorange},
        cgstage/deliver/.style={cgstage, fill=cgblue},
        % Bounding boxes
        cgpanel/.style={
            draw=cgslate,
            line width=1.0pt,
            dash pattern=on 4pt off 4pt,
            fill=cgpannelgray,
            rounded corners=2pt,
            inner sep=0.5cm,
        },
        % Arrows
        cgarr/.style={
            -{stealth},
            line width=1.0pt,
            draw=cgslate,
        },
        cgarrthin/.style={
            -{stealth},
            line width=0.8pt,
            draw=cglightgray,
        },
        % Edge labels
        cgedgelabel/.style={
            font=\cgfontinner,
            fill=white,
            inner sep=2pt,
            text=cgslate,
        },
        % Legacy and specific entity nodes
        cgnodefile/.style={cgnode, font=\cgfontinner\ttfamily},
        cgnodeclass/.style={cgnode, fill=cgblue, font=\cgfontinner\ttfamily},
        cgnodefunc/.style={cgnode, fill=cgorange, font=\cgfontinner\ttfamily},
        % Badges and labels
        cgbadge/.style={
            draw=cgslate,
            circle,
            line width=0.8pt,
            fill=white,
            minimum size=18pt,
            font=\cgfontinner\bfseries,
            inner sep=0pt,
        },
        cglabel/.style={
            font=\cgfontinner\itshape,
            text=cgslate,
            align=center,
        },
        cgactor/.style={
            cgnode,
            font=\cgfonttitle,
            minimum width=2.4cm,
            minimum height=1.0cm,
        },
        cgseqactor/.style={
            cgactor,
            minimum width=2.15cm,
            minimum height=0.85cm,
        },
        cglifeline/.style={
            dash pattern=on 4pt off 4pt,
            line width=0.8pt,
            draw=cgslate!40,
        },
    }%
}

% Sequence message at fixed depth below actor.south (cm); avoids stacked overlaps.
\newcommand{\cgseqmsg}[5]{%
    \draw[#1] ([yshift=-#2cm]#3.south) --
        node[cgmsg, midway, above=2pt] {#5} ([yshift=-#2cm]#4.south);%
}

% Short table note below a figure or table (detail stays in body text).
\newcommand{\cgtablenote}[1]{%
    \par\vspace{0.4em}%
    {\footnotesize #1}%
}

% Small sample edge for in-node legends (avoids nested tikzpicture environments).
\newcommand{\cglegendline}[2]{%
    \tikz[baseline=-0.55ex] {%
        \draw[-{Stealth[length=2mm, width=1.6mm]}, line width=0.9pt, #1] (0,0) -- (0.55,0);%
    }%
    \ #2%
}

% Consistent row spacing for Chapter 3 tables.
\newcommand{\cgtablerows}{%
    \renewcommand{\arraystretch}{1.2}%
}

% Monospace MCP/CLI name inside a fixed table column (prevents overflow into neighbors).
\newcommand{\cgtoolcell}[1]{%
    \begin{minipage}[t]{\linewidth}%
        \raggedright\ttfamily\footnotesize #1%
    \end{minipage}%
}

% Constrain screenshots and wide figures to the text block.
\newcommand{\cgincludegraphics}[2][]{%
    \includegraphics[width=0.95\linewidth,keepaspectratio,#1]{#2}%
}

% Scale a TikZ picture to fit the text width when coordinates exceed \textwidth.
\newcommand{\cgtikzfit}[1]{%
    \begin{adjustbox}{max width=\linewidth,center}%
        #1%
    \end{adjustbox}%
}

% Wrap a full-width listing + caption inside a figure so content stays within \linewidth.
\newenvironment{cglistingfigure}{%
    \begin{figure}[htbp]%
    \centering%
    \begin{minipage}{\linewidth}%
}{%
    \end{minipage}%
    \end{figure}%
}
